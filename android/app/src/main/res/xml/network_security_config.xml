<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS by default. Cleartext is permitted only for the addresses a development
  backend realistically listens on, so the runtime-editable server URL can point
  at a laptop while you build without weakening production traffic.
  10.0.2.2 is the host machine as seen from the Android emulator.

  103.205.142.172 is the current test API server, which doesn't have TLS set
  up yet — this is a deliberate, temporary exception for testing only. Every
  request to it (including login credentials and auth tokens) travels
  unencrypted and can be intercepted or tampered with on the network. Remove
  this entry once that server serves HTTPS; don't add a real production
  address here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">103.205.142.172</domain>
    </domain-config>
</network-security-config>
