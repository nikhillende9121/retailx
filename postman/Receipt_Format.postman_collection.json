              }
            ],
            "url": {
              "raw": "{{baseUrl}}/super-admin/receipt-formats/{{formatId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "super-admin",
                "receipt-formats",
                "{{formatId}}",
                "assign"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{saToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Assign to terminal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/super-admin/receipt-formats/{{formatId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "super-admin",
                "receipt-formats",
                "{{formatId}}",
                "assign"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{saToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"terminalId\": \"{{terminalId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. POS - what the app calls",
      "item": [
        {
          "name": "Get receipt format",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pos/{{terminalId}}/receipt-format",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pos",
                "{{terminalId}}",
                "receipt-format"
              ]
            },
            "description": "terminalId must be a numeric Terminal.id in the user's tenant, even for tenant/store-level assignments.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get receipt format version",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pos/{{terminalId}}/receipt-format/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pos",
                "{{terminalId}}",
                "receipt-format",
                "version"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}